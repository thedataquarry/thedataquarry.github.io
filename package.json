{
  "name": "astro-theme-pure",
  "type": "module",
  "version": "4.0.7",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev --watch",
    "dev:check": "astro check --watch & astro dev",
    "build": "astro-pure check && astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "astro": "astro",
    "pure": "astro-pure",
    "new": "astro-pure new",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "yijiansilian": "pnpm lint && pnpm sync && pnpm check && pnpm format",
    "clean": "rm -rf .astro .vercel dist"
  },
  "dependencies": {
    "@astro-community/astro-embed-twitter": "^0.5.8",
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "6.0.2",
    "@astrojs/rss": "^4.0.12",
    "@playform/compress": "^0.2.0",
    "@unocss/reset": "66.3.3",
    "@waline/client": "^3.6.0",
    "astro": "5.1.10",
    "astro-embed": "^0.9.0",
    "astro-pure": "workspace:*",
    "hastscript": "^9.0.1",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.3",
    "typescript": "^5.8.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "unocss": "66.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "shiki": "1.29.2",
    "typescript-eslint": "^8.37.0"
  },
  "pnpm": {
    "overrides": {
      "astro": "5.1.10"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
