---
import artifact from './tea-recommender-3d.json'

const artifactJson = JSON.stringify(artifact).replaceAll('<', '\\u003c')
const initialCheckpoint = artifact.checkpoints[artifact.checkpoints.length - 1]
---

<figure class='tea-explorer' data-tea-explorer>
  <header class='explorer-header'>
    <div>
      <p class='eyebrow'>Explore the preference memory</p>
      <h3>166 tea hypervectors in a shared 3D PCA space</h3>
      <p class='checkpoint-summary' data-checkpoint-summary>
        After {initialCheckpoint.event_count} tastings · {initialCheckpoint.positive_vote_weight}
        positive votes · {initialCheckpoint.negative_vote_weight} negative votes
      </p>
    </div>

    <button class='reset-view' type='button' data-reset-view>Reset view</button>
  </header>

  <div class='checkpoint-bar' aria-label='Preference-memory checkpoint'>
    <span>Click to see the memory after</span>
    {
      artifact.checkpoints.map((checkpoint) => (
        <button
          type='button'
          class='checkpoint-button'
          data-checkpoint={checkpoint.sequence}
          aria-pressed={checkpoint.sequence === initialCheckpoint.sequence ? 'true' : 'false'}
        >
          {checkpoint.sequence} tastings
        </button>
      ))
    }
  </div>

  <div class='explorer-stage' data-stage>
    <canvas
      data-canvas
      aria-label='Interactive 3D PCA plot of 166 tea hypervectors. Drag to rotate, right-drag to pan, and scroll to zoom.'
    ></canvas>
    <div class='hover-card' data-tooltip role='tooltip' hidden></div>
    <div class='prototype-annotation prototype-annotation--positive' data-positive-annotation>
      <span>Positive prototype</span><i aria-hidden='true'></i>
    </div>
    <div class='prototype-annotation prototype-annotation--negative' data-negative-annotation>
      <span>Avoid signal</span><i aria-hidden='true'></i>
    </div>
    <p class='interaction-hint'>Pan, zoom and rotate · Hover for descriptions</p>
    <p class='webgl-fallback' data-fallback hidden>
      This interactive view needs WebGL, which is unavailable in this browser.
    </p>
  </div>

  <div class='explorer-footer'>
    <div class='legend' aria-label='Tea classes'>
      {
        artifact.palette.classes.map((entry) => (
          <span>
            <i style={`--legend-color: ${entry.color}`} />
            {entry.label}
          </span>
        ))
      }
    </div>

    <section class='recommendations' aria-live='polite'>
      <p>Top recommendations in the original 10,000-dimensional space</p>
      <ol data-recommendations>
        {
          initialCheckpoint.recommendations.map((recommendation) => (
            <li>
              <span class='recommendation-rank'>{recommendation.rank}</span>
              <span>
                <strong>{recommendation.title}</strong>
                <small>
                  {recommendation.class} · score {recommendation.score.toFixed(4)}
                </small>
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <script is:inline type='application/json' data-artifact set:html={artifactJson} />
</figure>

<script>
  import * as THREE from 'three'
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js'

  type Position = [number, number, number]

  interface TeaRecord {
    id: string
    title: string
    class: string
    country: string | null
    region: string | null
    oxidation: string | null
    roast: string | null
    aroma: string[]
    taste: string[]
    position: Position
  }

  interface Tasting {
    tea_id: string
    verdict: 'liked' | 'disliked' | 'neutral'
    strength: number
  }

  interface Recommendation {
    rank: number
    tea_id: string
    title: string
    class: string
    score: number
    positive_similarity: number
    negative_similarity: number | null
  }

  interface Checkpoint {
    sequence: number
    event_count: number
    positive_vote_weight: number
    negative_vote_weight: number
    positive_position: Position
    negative_position: Position | null
    tastings: Tasting[]
    recommendations: Recommendation[]
  }

  interface Artifact {
    palette: {
      classes: Array<{ class: string; label: string; color: string }>
      signals: Record<string, string>
    }
    teas: TeaRecord[]
    checkpoints: Checkpoint[]
  }

  const requireElement = <T extends Element>(root: ParentNode, selector: string): T => {
    const element = root.querySelector<T>(selector)
    if (!element) throw new Error(`Tea explorer is missing ${selector}`)
    return element
  }

  const makePointTexture = (ring = false): THREE.CanvasTexture => {
    const textureCanvas = document.createElement('canvas')
    textureCanvas.width = 96
    textureCanvas.height = 96
    const context = textureCanvas.getContext('2d')
    if (!context) throw new Error('Could not create a point texture')

    context.clearRect(0, 0, 96, 96)
    if (ring) {
      context.strokeStyle = '#ffffff'
      context.lineWidth = 9
      context.beginPath()
      context.arc(48, 48, 35, 0, Math.PI * 2)
      context.stroke()
    } else {
      const glow = context.createRadialGradient(48, 48, 4, 48, 48, 44)
      glow.addColorStop(0, 'rgba(255,255,255,1)')
      glow.addColorStop(0.58, 'rgba(255,255,255,0.96)')
      glow.addColorStop(0.72, 'rgba(255,255,255,0.32)')
      glow.addColorStop(1, 'rgba(255,255,255,0)')
      context.fillStyle = glow
      context.beginPath()
      context.arc(48, 48, 46, 0, Math.PI * 2)
      context.fill()
    }
    const texture = new THREE.CanvasTexture(textureCanvas)
    texture.colorSpace = THREE.SRGBColorSpace
    return texture
  }

  const makeDoubleTetrahedronGeometry = (
    radius = 0.27,
    halfHeight = 0.39
  ): THREE.BufferGeometry => {
    const top = new THREE.Vector3(0, halfHeight, 0)
    const bottom = new THREE.Vector3(0, -halfHeight, 0)
    const equator = Array.from({ length: 3 }, (_, index) => {
      const angle = (Math.PI * 2 * index) / 3
      return new THREE.Vector3(radius * Math.cos(angle), 0, radius * Math.sin(angle))
    })
    const faces = [
      [top, equator[1], equator[0]],
      [top, equator[2], equator[1]],
      [top, equator[0], equator[2]],
      [bottom, equator[0], equator[1]],
      [bottom, equator[1], equator[2]],
      [bottom, equator[2], equator[0]]
    ]
    const positions = new Float32Array(
      faces.flatMap((face) => face.flatMap((vertex) => vertex.toArray()))
    )
    const geometry = new THREE.BufferGeometry()
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3))
    geometry.computeVertexNormals()
    return geometry
  }

  const initExplorer = (root: HTMLElement): void => {
    if (root.dataset.ready === 'true') return
    root.dataset.ready = 'true'

    const canvas = requireElement<HTMLCanvasElement>(root, '[data-canvas]')
    const stage = requireElement<HTMLElement>(root, '[data-stage]')
    const tooltip = requireElement<HTMLElement>(root, '[data-tooltip]')
    const positiveAnnotation = requireElement<HTMLElement>(root, '[data-positive-annotation]')
    const negativeAnnotation = requireElement<HTMLElement>(root, '[data-negative-annotation]')
    const fallback = requireElement<HTMLElement>(root, '[data-fallback]')
    const summary = requireElement<HTMLElement>(root, '[data-checkpoint-summary]')
    const recommendationList = requireElement<HTMLOListElement>(root, '[data-recommendations]')
    const artifactElement = requireElement<HTMLScriptElement>(root, '[data-artifact]')
    const data = JSON.parse(artifactElement.textContent ?? '') as Artifact

    let renderer: THREE.WebGLRenderer
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false })
    } catch (error) {
      console.error(error)
      canvas.hidden = true
      fallback.hidden = false
      return
    }

    renderer.setClearColor('#09171F', 1)
    renderer.outputColorSpace = THREE.SRGBColorSpace
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))

    const scene = new THREE.Scene()
    scene.fog = new THREE.FogExp2('#09171F', 0.035)

    const camera = new THREE.OrthographicCamera(-6, 6, 6, -6, 0.1, 100)
    const initialCamera = new THREE.Vector3(8.5, 6.2, 9.5)
    camera.position.copy(initialCamera)

    const controls = new OrbitControls(camera, canvas)
    controls.enableDamping = false
    controls.enablePan = true
    controls.enableRotate = true
    controls.enableZoom = true
    controls.zoomSpeed = 1.5
    controls.screenSpacePanning = true
    controls.minZoom = 0.65
    controls.maxZoom = 6
    controls.target.set(0, 0, 0)
    controls.update()

    const allPositions = [
      ...data.teas.map((tea) => tea.position),
      ...data.checkpoints.map((checkpoint) => checkpoint.positive_position),
      ...data.checkpoints.flatMap((checkpoint) =>
        checkpoint.negative_position ? [checkpoint.negative_position] : []
      )
    ]
    const minimum = new THREE.Vector3(Infinity, Infinity, Infinity)
    const maximum = new THREE.Vector3(-Infinity, -Infinity, -Infinity)
    for (const position of allPositions) {
      minimum.min(new THREE.Vector3(...position))
      maximum.max(new THREE.Vector3(...position))
    }
    const center = minimum.clone().add(maximum).multiplyScalar(0.5)
    const span = maximum.clone().sub(minimum)
    const scale = 8 / Math.max(span.x, span.y, span.z, 1e-9)
    const transform = (position: Position): THREE.Vector3 =>
      new THREE.Vector3(...position).sub(center).multiplyScalar(scale)

    const classColors = new Map(
      data.palette.classes.map((entry) => [entry.class, new THREE.Color(entry.color)])
    )
    const teaById = new Map(data.teas.map((tea) => [tea.id, tea]))
    const transformedPositions = data.teas.map((tea) => transform(tea.position))
    const positionAttribute = new Float32Array(data.teas.length * 3)
    const colorAttribute = new Float32Array(data.teas.length * 3)
    data.teas.forEach((tea, index) => {
      const position = transformedPositions[index]
      positionAttribute.set(position.toArray(), index * 3)
      const color = classColors.get(tea.class)
      if (!color) throw new Error(`No color for tea class ${tea.class}`)
      colorAttribute.set(color.toArray(), index * 3)
    })

    const pointTexture = makePointTexture()
    const ringTexture = makePointTexture(true)
    const pointGeometry = new THREE.BufferGeometry()
    pointGeometry.setAttribute('position', new THREE.BufferAttribute(positionAttribute, 3))
    pointGeometry.setAttribute('color', new THREE.BufferAttribute(colorAttribute, 3))
    const pointMaterial = new THREE.PointsMaterial({
      // PointsMaterial uses screen pixels with an orthographic camera.
      size: 11.5,
      map: pointTexture,
      alphaTest: 0.04,
      transparent: true,
      opacity: 0.92,
      vertexColors: true,
      depthWrite: false,
      sizeAttenuation: true
    })
    const points = new THREE.Points(pointGeometry, pointMaterial)
    scene.add(points)

    const gridRadius =
      Math.max(...allPositions.map((position) => transform(position).length())) * 1.08
    const gridMaterial = new THREE.LineBasicMaterial({
      color: '#B8CDD1',
      transparent: true,
      opacity: 0.2,
      depthWrite: false
    })
    const gridGroup = new THREE.Group()
    const gridSegments = 96
    const addGridCircle = (positions: THREE.Vector3[]): void => {
      const geometry = new THREE.BufferGeometry().setFromPoints(positions)
      gridGroup.add(new THREE.LineLoop(geometry, gridMaterial))
    }

    // Latitude rings.
    for (let latitudeIndex = 1; latitudeIndex < 12; latitudeIndex += 1) {
      const latitude = -Math.PI / 2 + (Math.PI * latitudeIndex) / 12
      const ringRadius = gridRadius * Math.cos(latitude)
      const y = gridRadius * Math.sin(latitude)
      addGridCircle(
        Array.from({ length: gridSegments }, (_, index) => {
          const angle = (Math.PI * 2 * index) / gridSegments
          return new THREE.Vector3(ringRadius * Math.cos(angle), y, ringRadius * Math.sin(angle))
        })
      )
    }

    // Great circles form eighteen longitude meridians without triangular diagonals.
    for (let longitudeIndex = 0; longitudeIndex < 9; longitudeIndex += 1) {
      const longitude = (Math.PI * longitudeIndex) / 9
      addGridCircle(
        Array.from({ length: gridSegments }, (_, index) => {
          const angle = (Math.PI * 2 * index) / gridSegments
          const radialDistance = gridRadius * Math.sin(angle)
          return new THREE.Vector3(
            radialDistance * Math.cos(longitude),
            gridRadius * Math.cos(angle),
            radialDistance * Math.sin(longitude)
          )
        })
      )
    }

    scene.add(gridGroup)

    const checkpointGroup = new THREE.Group()
    scene.add(checkpointGroup)

    scene.add(new THREE.HemisphereLight('#E9FFFF', '#10222A', 1.7))
    const markerLight = new THREE.DirectionalLight('#FFFFFF', 2.4)
    markerLight.position.set(4, 7, 6)
    scene.add(markerLight)

    const prototypeGeometry = makeDoubleTetrahedronGeometry()
    const positiveMaterial = new THREE.MeshPhongMaterial({
      color: data.palette.signals.positive,
      emissive: data.palette.signals.positive,
      emissiveIntensity: 0.08,
      flatShading: true,
      shininess: 70,
      specular: '#DFFFF9',
      fog: false
    })
    const positivePrototype = new THREE.Mesh(prototypeGeometry, positiveMaterial)
    positivePrototype.rotation.y = Math.PI / 8
    checkpointGroup.add(positivePrototype)

    const negativeMaterial = new THREE.MeshPhongMaterial({
      color: data.palette.signals.negative,
      emissive: data.palette.signals.negative,
      emissiveIntensity: 0.06,
      flatShading: true,
      shininess: 60,
      specular: '#FFD6DC',
      fog: false
    })
    const negativePrototype = new THREE.Mesh(prototypeGeometry, negativeMaterial)
    negativePrototype.rotation.y = -Math.PI / 8
    checkpointGroup.add(negativePrototype)

    const pathMaterial = new THREE.LineBasicMaterial({
      color: data.palette.signals.positive,
      transparent: true,
      opacity: 0.58,
      fog: false
    })
    const prototypePath = new THREE.Line(new THREE.BufferGeometry(), pathMaterial)
    checkpointGroup.add(prototypePath)

    const hoverMaterial = new THREE.SpriteMaterial({
      map: ringTexture,
      color: '#ffffff',
      transparent: true,
      opacity: 0.9,
      depthTest: false,
      fog: false
    })
    const hoverMarker = new THREE.Sprite(hoverMaterial)
    hoverMarker.scale.setScalar(0.62)
    hoverMarker.visible = false
    scene.add(hoverMarker)

    const transientMarkers = new THREE.Group()
    scene.add(transientMarkers)
    const cubeSourceGeometry = new THREE.BoxGeometry(1, 1, 1)
    const tastedCubeGeometry = new THREE.EdgesGeometry(cubeSourceGeometry)
    cubeSourceGeometry.dispose()
    const tastedCubeMaterial = new THREE.LineBasicMaterial({
      color: '#FFFFFF',
      transparent: true,
      opacity: 0.9,
      depthTest: false,
      fog: false
    })
    const addCube = (position: THREE.Vector3, size: number): void => {
      const marker = new THREE.LineSegments(tastedCubeGeometry, tastedCubeMaterial)
      marker.position.copy(position)
      marker.rotation.set(Math.PI / 7, Math.PI / 4, 0)
      marker.scale.setScalar(size)
      transientMarkers.add(marker)
    }
    const addRing = (position: THREE.Vector3, color: string, size: number): void => {
      const material = new THREE.SpriteMaterial({
        map: ringTexture,
        color,
        transparent: true,
        opacity: 0.9,
        depthTest: false,
        fog: false
      })
      const marker = new THREE.Sprite(material)
      marker.position.copy(position)
      marker.scale.setScalar(size)
      transientMarkers.add(marker)
    }

    const raycaster = new THREE.Raycaster()
    raycaster.params.Points = { threshold: 0.22 }
    const pointer = new THREE.Vector2()
    let activeCheckpoint = data.checkpoints[data.checkpoints.length - 1]

    const positionAnnotation = (annotation: HTMLElement, marker: THREE.Object3D): void => {
      const position = marker.position.clone().project(camera)
      annotation.style.left = `${(position.x * 0.5 + 0.5) * stage.clientWidth}px`
      annotation.style.top = `${(-position.y * 0.5 + 0.5) * stage.clientHeight}px`
    }

    const render = (): void => {
      renderer.render(scene, camera)
      positionAnnotation(positiveAnnotation, positivePrototype)
      if (negativePrototype.visible) positionAnnotation(negativeAnnotation, negativePrototype)
    }

    const renderRecommendations = (checkpoint: Checkpoint): void => {
      recommendationList.replaceChildren()
      for (const recommendation of checkpoint.recommendations) {
        const item = document.createElement('li')
        const rank = document.createElement('span')
        rank.className = 'recommendation-rank'
        rank.textContent = String(recommendation.rank)
        const text = document.createElement('span')
        const title = document.createElement('strong')
        title.textContent = recommendation.title
        const details = document.createElement('small')
        details.textContent = `${recommendation.class} · score ${recommendation.score.toFixed(4)}`
        text.append(title, details)
        item.append(rank, text)
        recommendationList.append(item)
      }
    }

    const clearTransientMarkers = (): void => {
      for (const child of [...transientMarkers.children]) {
        transientMarkers.remove(child)
        if (child instanceof THREE.Sprite) child.material.dispose()
      }
    }

    const setCheckpoint = (checkpoint: Checkpoint): void => {
      activeCheckpoint = checkpoint
      clearTransientMarkers()

      checkpoint.tastings.forEach((tasting) => {
        const tea = teaById.get(tasting.tea_id)
        if (!tea) return
        addCube(transform(tea.position), 0.16)
      })
      checkpoint.recommendations.forEach((recommendation) => {
        const tea = teaById.get(recommendation.tea_id)
        if (tea) addRing(transform(tea.position), data.palette.signals.recommendation, 0.31)
      })

      positivePrototype.position.copy(transform(checkpoint.positive_position))
      if (checkpoint.negative_position) {
        negativePrototype.position.copy(transform(checkpoint.negative_position))
        negativePrototype.visible = true
        negativeAnnotation.hidden = false
      } else {
        negativePrototype.visible = false
        negativeAnnotation.hidden = true
      }

      const checkpointIndex = data.checkpoints.indexOf(checkpoint)
      const pathPositions = data.checkpoints
        .slice(0, checkpointIndex + 1)
        .map((entry) => transform(entry.positive_position))
      prototypePath.geometry.dispose()
      prototypePath.geometry = new THREE.BufferGeometry().setFromPoints(pathPositions)
      prototypePath.visible = pathPositions.length > 1

      summary.textContent = `After ${checkpoint.event_count} tastings · ${checkpoint.positive_vote_weight} positive votes · ${checkpoint.negative_vote_weight} negative votes`
      root.querySelectorAll<HTMLButtonElement>('[data-checkpoint]').forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          button.dataset.checkpoint === String(checkpoint.sequence) ? 'true' : 'false'
        )
      })
      renderRecommendations(checkpoint)
      render()
    }

    const addTooltipField = (label: string, value: string): void => {
      const row = document.createElement('div')
      const term = document.createElement('dt')
      term.textContent = label
      const description = document.createElement('dd')
      description.textContent = value || 'Not specified'
      row.append(term, description)
      requireElement<HTMLDListElement>(tooltip, 'dl').append(row)
    }

    const showTooltip = (tea: TeaRecord, clientX: number, clientY: number): void => {
      const title = document.createElement('strong')
      title.textContent = tea.title
      const subtitle = document.createElement('span')
      subtitle.textContent = `${tea.class.toUpperCase()} · ID ${tea.id}`
      const details = document.createElement('dl')
      tooltip.replaceChildren(title, subtitle, details)
      addTooltipField('Country', tea.country ?? 'Not specified')
      addTooltipField('Region', tea.region ?? 'Not specified')
      addTooltipField('Oxidation', tea.oxidation ?? 'Not specified')
      addTooltipField('Roast', tea.roast ?? 'Not specified')
      addTooltipField('Aroma', tea.aroma.join(', '))
      addTooltipField('Taste', tea.taste.join(', '))

      const tasting = activeCheckpoint.tastings.find((entry) => entry.tea_id === tea.id)
      const recommendation = activeCheckpoint.recommendations.find(
        (entry) => entry.tea_id === tea.id
      )
      if (tasting)
        addTooltipField('At this checkpoint', `${tasting.verdict}, strength ${tasting.strength}`)
      if (recommendation) {
        addTooltipField(
          'Recommendation',
          `#${recommendation.rank}, score ${recommendation.score.toFixed(4)}`
        )
      }

      tooltip.hidden = false
      const stageBounds = stage.getBoundingClientRect()
      const tooltipBounds = tooltip.getBoundingClientRect()
      const preferredLeft = clientX - stageBounds.left + 16
      const preferredTop = clientY - stageBounds.top + 16
      tooltip.style.left = `${Math.min(preferredLeft, stageBounds.width - tooltipBounds.width - 12)}px`
      tooltip.style.top = `${Math.min(preferredTop, stageBounds.height - tooltipBounds.height - 12)}px`
    }

    const inspectPointer = (event: PointerEvent): void => {
      const bounds = canvas.getBoundingClientRect()
      pointer.x = ((event.clientX - bounds.left) / bounds.width) * 2 - 1
      pointer.y = -((event.clientY - bounds.top) / bounds.height) * 2 + 1
      raycaster.setFromCamera(pointer, camera)
      const intersection = raycaster.intersectObject(points, false)[0]
      const nextIndex = intersection?.index ?? null
      if (nextIndex === null) {
        hoverMarker.visible = false
        tooltip.hidden = true
        canvas.style.cursor = 'grab'
        render()
        return
      }

      hoverMarker.position.copy(transformedPositions[nextIndex])
      hoverMarker.visible = true
      canvas.style.cursor = 'pointer'
      showTooltip(data.teas[nextIndex], event.clientX, event.clientY)
      render()
    }

    const resize = (): void => {
      const width = Math.max(stage.clientWidth, 1)
      const height = Math.max(stage.clientHeight, 1)
      const aspect = width / height
      const verticalSpan = gridRadius * 2.15
      camera.left = (-verticalSpan * aspect) / 2
      camera.right = (verticalSpan * aspect) / 2
      camera.top = verticalSpan / 2
      camera.bottom = -verticalSpan / 2
      camera.updateProjectionMatrix()
      renderer.setSize(width, height, false)
      render()
    }

    controls.addEventListener('change', render)
    canvas.addEventListener('pointermove', inspectPointer)
    canvas.addEventListener('pointerleave', () => {
      hoverMarker.visible = false
      tooltip.hidden = true
      canvas.style.cursor = 'grab'
      render()
    })
    root.querySelectorAll<HTMLButtonElement>('[data-checkpoint]').forEach((button) => {
      button.addEventListener('click', () => {
        const checkpoint = data.checkpoints.find(
          (entry) => entry.sequence === Number(button.dataset.checkpoint)
        )
        if (checkpoint) setCheckpoint(checkpoint)
      })
    })
    requireElement<HTMLButtonElement>(root, '[data-reset-view]').addEventListener('click', () => {
      camera.position.copy(initialCamera)
      camera.zoom = 1
      camera.updateProjectionMatrix()
      controls.target.set(0, 0, 0)
      controls.update()
      render()
    })

    const resizeObserver = new ResizeObserver(resize)
    resizeObserver.observe(stage)
    setCheckpoint(activeCheckpoint)
    resize()

    document.addEventListener(
      'astro:before-swap',
      () => {
        resizeObserver.disconnect()
        controls.dispose()
        renderer.dispose()
        pointTexture.dispose()
        ringTexture.dispose()
      },
      { once: true }
    )
  }

  const initExplorers = (): void => {
    document.querySelectorAll<HTMLElement>('[data-tea-explorer]').forEach(initExplorer)
  }

  initExplorers()
  document.addEventListener('astro:page-load', initExplorers)
</script>

<style>
  .tea-explorer {
    --panel: #071117;
    --plot: #09171f;
    --foreground: #eaf3f2;
    --muted: #8fa5ae;
    --subtle: #38505a;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    margin: 2.25rem 0;
    overflow: hidden;
    color: var(--foreground);
    background: var(--panel);
    border: 1px solid color-mix(in srgb, var(--subtle), transparent 20%);
    border-radius: 1rem;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 22%);
  }

  .explorer-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.15rem 1.25rem 0.85rem;
  }

  .eyebrow,
  .checkpoint-summary,
  .recommendations > p,
  .interaction-hint {
    margin: 0;
  }

  .eyebrow {
    color: #74e5d0;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .explorer-header h3 {
    margin: 0.2rem 0 0.25rem;
    color: var(--foreground);
    font-size: clamp(1rem, 2vw, 1.35rem);
    line-height: 1.25;
